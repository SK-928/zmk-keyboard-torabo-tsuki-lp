#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <220>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&pointing_listener {
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_scaler 2 3>,
        <&zip_temp_layer 4 600>;

    scroller {
        layers = <5>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 40>,
            <&zip_temp_layer 4 600>;
    };
};

&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <25 26 27 28 33 34 35>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <33 34>;
            layers = <2>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans            &trans          &trans          &trans            &trans                            &trans       &trans  &trans     &trans        &trans        &trans
&trans  &kp Q             &kp W           &kp E           &kp R             &kp T                             &kp Y        &kp U   &kp I      &kp O         &kp P         &trans
&trans  &mt LCTRL A       &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LEFT_SHIFT F  &kp G      &trans     &trans      &kp H        &kp J   &kp K      &kp L         &kp ENTER     &kp BACKSPACE
&trans  &mt LEFT_SHIFT Z  &kp X           &kp C           &kp V             &kp B      &kp F10    &kp ESCAPE  &kp N        &kp M   &kp COMMA  &kp DOT       &kp SLASH     &trans
&trans  &trans            &trans          &trans          &lt 1 TAB         &kp LANG2  &kp SPACE  &kp MINUS   &lt 2 LANG1  &trans  &trans     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans                         &trans                     &trans                 &trans                       &trans                                 &trans            &trans            &trans             &trans           &trans         &trans
&trans  &kp NUMBER_1                   &kp NUMBER_2               &kp NUMBER_3           &kp NUMBER_4                 &kp NUMBER_5                           &kp NUMBER_6      &kp NUMBER_7      &kp NUMBER_8       &kp NUMBER_9     &kp NUMBER_0   &trans
&trans  &mt LEFT_CONTROL LS(NUMBER_1)  &mt LEFT_ALT LS(NUMBER_2)  &mt LGUI LS(NUMBER_3)  &mt LEFT_SHIFT LS(NUMBER_4)  &kp LS(N5)    &trans  &trans           &kp LS(NUMBER_6)  &kp LS(N7)        &kp RIGHT_BRACKET  &kp NON_US_HASH  &kp SQT        &trans
&trans  &kp LEFT_SHIFT                 &trans                     &trans                 &trans                       &trans        &trans  &kp LS(INT_YEN)  &kp LS(INT_RO)    &kp LEFT_BRACKET  &kp LS(N8)         &kp LS(N9)       &kp SEMICOLON  &trans
&trans  &trans                         &trans                     &trans                 &trans                       &trans        &trans  &kp EQUAL        &kp INT_YEN       &trans            &trans             &trans           &trans         &bt BT_CLR
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans          &trans        &trans        &trans          &trans                  &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans          &trans        &trans        &trans          &trans                  &trans          &trans          &trans        &trans           &trans  &trans
&trans  &kp LCTRL       &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &kp LEFT_SHIFT  &trans        &trans        &trans          &trans  &trans  &trans  &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans          &trans        &trans        &trans          &trans  &trans  &trans  &trans          &trans          &trans        &trans           &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans        &trans     &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 5   &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
